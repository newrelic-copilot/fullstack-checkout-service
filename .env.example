# New Relic Configuration
# Get your license key from: https://one.newrelic.com/launcher/api-keys-ui.api-keys-launcher
NEW_RELIC_LICENSE_KEY=your_license_key_here
NEW_RELIC_APP_NAME=Fullstack Checkout Service

# Optional: Path to New Relic configuration file
# NEW_RELIC_CONFIG_FILE=./newrelic.ini

# Optional: Set to 'false' to disable New Relic monitoring
# NEW_RELIC_MONITOR_MODE=true

# Optional: Set logging level (critical, error, warning, info, debug)
# NEW_RELIC_LOG_LEVEL=info

# Optional: Set to 'true' to enable high security mode
# NEW_RELIC_HIGH_SECURITY=false
