# New Relic Configuration
# Copy this file to .env and fill in your values

# Required: Your New Relic license key
# Get this from: https://one.newrelic.com/launcher/api-keys-ui.api-keys-launcher
NEW_RELIC_LICENSE_KEY=your_license_key_here

# Required: Application name as it appears in New Relic
NEW_RELIC_APP_NAME=Fullstack Checkout Service

# Optional: Environment (development, test, staging, production)
# Default: development
NEW_RELIC_ENVIRONMENT=production

# Optional: Path to New Relic configuration file
# Default: newrelic.ini
NEW_RELIC_CONFIG_FILE=newrelic.ini

# Optional: Log level (critical, error, warning, info, debug)
# Default: info
NEW_RELIC_LOG_LEVEL=info

# Optional: Enable distributed tracing
# Default: true
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true

# Optional: Enable high security mode
# Default: false
NEW_RELIC_HIGH_SECURITY=false
