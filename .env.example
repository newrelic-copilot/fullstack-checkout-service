# New Relic Configuration
# Get your license key from: https://one.newrelic.com/api-keys

# Required: Your New Relic license key
NEW_RELIC_LICENSE_KEY=your_license_key_here

# Optional: Application name (defaults to "Fullstack Checkout Service")
# NEW_RELIC_APP_NAME=Fullstack Checkout Service

# Optional: New Relic configuration file path (defaults to "newrelic.ini")
# NEW_RELIC_CONFIG_FILE=newrelic.ini

# Optional: Environment name (defaults to "development")
# Options: development, test, staging, production
# NEW_RELIC_ENVIRONMENT=development

# Optional: Enable/disable logging to file
# NEW_RELIC_LOG=stdout

# Optional: Log level (defaults to "info")
# Options: critical, error, warning, info, debug
# NEW_RELIC_LOG_LEVEL=info
