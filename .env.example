# New Relic Configuration
# Get your license key from: https://one.newrelic.com/admin-portal/api-keys/home

# Required: Your New Relic license key
NEW_RELIC_LICENSE_KEY=your_license_key_here

# Required: Application name as it will appear in New Relic
NEW_RELIC_APP_NAME=fullstack-checkout-service

# Optional: Environment name (development, test, staging, production)
# Default: development
NEW_RELIC_ENVIRONMENT=development
