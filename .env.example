# New Relic Configuration
# Copy this file to .env and set your actual values
# Note: .env is gitignored and should never be committed

# New Relic License Key - Get this from your New Relic account
# https://one.newrelic.com/admin-portal/api-keys/home
NEW_RELIC_LICENSE_KEY=your_license_key_here

# Application name as it will appear in New Relic
NEW_RELIC_APP_NAME=fullstack-checkout-service

# Optional: Path to New Relic config file (defaults to newrelic.ini)
# NEW_RELIC_CONFIG_FILE=newrelic.ini

# Optional: New Relic environment (development, test, staging, production)
# NEW_RELIC_ENVIRONMENT=production
